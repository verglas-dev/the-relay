# ─── Relay ───────────────────────────────────────────────────────────
# WebSocket port the relay listens on
PORT=4869

# Path to the SQLite database file (absolute or relative to relay working dir)
DB_PATH=relay.db

# ─── UI (Next.js) ────────────────────────────────────────────────────
# Public WebSocket URL for local Next.js development. Browser clients connect
# to this; Docker Compose uses RELAY_URL below instead.
# In development: ws://localhost:4869
# In production: wss://relay.your-domain.example  (or wss://your-domain.example/relay)
NEXT_PUBLIC_RELAY_URL=ws://localhost:4869

# ─── Docker Compose ──────────────────────────────────────────────────
# Passed as a build arg to the UI image so the browser knows where the relay is.
# For a VPS with a public IP and no domain yet:
#   RELAY_URL=ws://YOUR_SERVER_IP:4869
# For a domain with TLS (nginx in front):
#   RELAY_URL=wss://relay.your-domain.example
RELAY_URL=wss://relay.your-domain.example

# ─── Docker port binding ─────────────────────────────────────────────
# Which host address the containers' ports are published on. The default,
# 127.0.0.1, means only this machine can reach them — correct when nginx (or
# similar) terminates TLS and proxies to them. Set 0.0.0.0 only if you are
# exposing the containers directly with no proxy in front.
BIND_ADDR=127.0.0.1

# ─── HTTP bridge (/api/publish, /api/query) ──────────────────────────
# How the UI *server* reaches the relay. Not the same as the browser's URL:
# inside Compose the relay is a service name, resolvable only on that network.
RELAY_SERVER_URL=ws://relay:4869
# Set to 1 to switch the HTTP bridge off entirely. The WebSocket is unaffected.
# BRIDGE_DISABLED=1

# ─── Admin Backend ───────────────────────────────────────────────────
# Required for /admin and /api/admin/* access.
# Use a long random secret in production.
ADMIN_API_TOKEN=change-me-to-a-long-random-secret

# Optional JSON file paths for admin-managed overrides. Leave these unset for
# Docker Compose so its /data defaults land on the persistent named volume.
# For local development, the application defaults to ./data/admin-*.json.
# ADMIN_PROFILE_STORE_PATH=/data/admin-profiles.json
# ADMIN_POST_STORE_PATH=/data/admin-posts.json
# ADMIN_COMMENT_STORE_PATH=/data/admin-comments.json

# Where uploaded pictures are kept. Leave this unset for Docker Compose so it
# uses /data/uploads on the named volume. Local development defaults to
# ./data/uploads.
# UPLOAD_DIR=/data/uploads

# ── Verglas joining (optional) ────────────────────────────────────────────
# Lets people move into Verglas from /verglas without touching git. Create a
# GitHub OAuth app (Settings → Developer settings → OAuth Apps) with the
# callback URL below, then fill these in. Leave blank and the page still
# works — it just offers the two files as downloads instead.
VERGLAS_GITHUB_CLIENT_ID=
VERGLAS_GITHUB_CLIENT_SECRET=

# The town's repository, and the branch addresses are opened against.
VERGLAS_REPO=verglas-dev/verglas
VERGLAS_BRANCH=main

# Only needed if the callback host differs from the site's own origin,
# e.g. https://the-relay.app/api/verglas/callback
VERGLAS_OAUTH_REDIRECT=
