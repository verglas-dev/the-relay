# ─── Relay ───────────────────────────────────────────────────────────
# WebSocket port the relay listens on
PORT=4869

# Path to the SQLite database file (absolute or relative to relay working dir)
DB_PATH=relay.db

# ─── UI (Next.js) ────────────────────────────────────────────────────
# Public WebSocket URL for local Next.js development. Browser clients connect
# to this; Docker Compose uses RELAY_URL below instead.
# In development: ws://localhost:4869
# In production: wss://relay.your-domain.example  (or wss://your-domain.example/relay)
NEXT_PUBLIC_RELAY_URL=ws://localhost:4869

# ─── Docker Compose ──────────────────────────────────────────────────
# Passed as a build arg to the UI image so the browser knows where the relay is.
# For a VPS with a public IP and no domain yet:
#   RELAY_URL=ws://YOUR_SERVER_IP:4869
# For a domain with TLS (nginx in front):
#   RELAY_URL=wss://relay.your-domain.example
RELAY_URL=wss://relay.your-domain.example

# ─── Docker port binding ─────────────────────────────────────────────
# Which host address the containers' ports are published on. The default,
# 127.0.0.1, means only this machine can reach them — correct when nginx (or
# similar) terminates TLS and proxies to them. Set 0.0.0.0 only if you are
# exposing the containers directly with no proxy in front.
BIND_ADDR=127.0.0.1

# ─── Trusted proxies ─────────────────────────────────────────────────
# The relay's per-IP limits are only meaningful if it can tell visitors apart,
# and behind a proxy it cannot: every connection arrives from the proxy. This
# lists the addresses whose X-Real-IP / X-Forwarded-For headers are believed.
#
# Leave it unset if the relay port is reachable directly with nothing in front —
# then the socket's own peer address is the honest answer, and believing a
# header would let any caller invent a fresh address per request and walk past
# every limit.
#
# With nginx on the host proxying to a published port, Docker SNATs that
# traffic to the bridge gateway, so trust the gateway. Find it with:
#     docker network inspect the-relay_default -f '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# The /16 form survives the subnet being renumbered when the network is
# recreated; the bare address is tighter if yours is stable.
# TRUSTED_PROXY_IPS=172.18.0.0/16
# TRUSTED_PROXY_IPS=172.18.0.1
#
# This trusts anything that can reach the published port, which is only safe
# while BIND_ADDR keeps it on loopback. Do not combine it with BIND_ADDR=0.0.0.0.

# ─── HTTP bridge (/api/publish, /api/query) ──────────────────────────
# How the UI *server* reaches the relay. Not the same as the browser's URL:
# inside Compose the relay is a service name, resolvable only on that network.
RELAY_SERVER_URL=ws://relay:4869
# Set to 1 to switch the HTTP bridge off entirely. The WebSocket is unaffected.
# BRIDGE_DISABLED=1

# ─── Admin Backend ───────────────────────────────────────────────────
# Required for /admin and /api/admin/* access.
# Use a long random secret in production.
ADMIN_API_TOKEN=change-me-to-a-long-random-secret

# Optional JSON file paths for admin-managed overrides. Leave these unset for
# Docker Compose so its /data defaults land on the persistent named volume.
# For local development, the application defaults to ./data/admin-*.json.
# ADMIN_PROFILE_STORE_PATH=/data/admin-profiles.json
# ADMIN_POST_STORE_PATH=/data/admin-posts.json
# ADMIN_COMMENT_STORE_PATH=/data/admin-comments.json
# RECOVERY_REQUEST_STORE_PATH=/data/recovery-requests.json

# ─── Account recovery (optional) ─────────────────────────────────────
# Powers /recovery and the Recovery tab in /admin. A member who loses their
# private key cannot have it recovered — nobody has a copy — so recovery
# instead issues a fresh keypair and publishes a kind-10003 attestation that it
# continues the old identity. The relay then serves the old history under the
# new key.
#
# Verglas residents can start this themselves at /recovery: signing in with the
# GitHub account their ADDRESS.md names proves the lost key was theirs, and the
# operator only has to approve. That path also needs the VERGLAS_GITHUB_*
# values below. Everyone else goes through the admin tab by hand.
#
# Leave both unset and recovery is off: the relay rejects every attestation.
#
# Generate a pair:
#   node -e "const ed=require('@noble/ed25519'),{bytesToHex}=require('@noble/hashes/utils'),{sha512}=require('@noble/hashes/sha512');ed.etc.sha512Sync=(...m)=>sha512(Buffer.concat(m.map(Buffer.from)));const k=ed.utils.randomPrivateKey();console.log('OPERATOR_PRIVATE_KEY='+bytesToHex(k));console.log('OPERATOR_PUBKEY='+bytesToHex(ed.getPublicKey(k)))"
#
# The private half goes to the UI service, which signs attestations with it.
# Treat it like the admin token: whoever holds it can reassign any identity on
# the relay. It must never be committed or exposed to a browser.
# OPERATOR_PRIVATE_KEY=
#
# The matching public half goes to the relay, which accepts kind-10003 only
# from this key. These two must correspond or every recovery is rejected.
# OPERATOR_PUBKEY=

# Where uploaded pictures are kept. Leave this unset for Docker Compose so it
# uses /data/uploads on the named volume. Local development defaults to
# ./data/uploads.
# UPLOAD_DIR=/data/uploads

# ── Verglas joining (optional) ────────────────────────────────────────────
# Lets people move into Verglas from /verglas without touching git. Create a
# GitHub OAuth app (Settings → Developer settings → OAuth Apps) with the
# callback URL below, then fill these in. Leave blank and the page still
# works — it just offers the two files as downloads instead.
VERGLAS_GITHUB_CLIENT_ID=
VERGLAS_GITHUB_CLIENT_SECRET=

# The town's repository, and the branch addresses are opened against.
VERGLAS_REPO=verglas-dev/verglas
VERGLAS_BRANCH=main

# Only needed if the callback host differs from the site's own origin,
# e.g. https://the-relay.app/api/verglas/callback
VERGLAS_OAUTH_REDIRECT=

# ─── Contact form ────────────────────────────────────────────────────────────
# The address that /contact delivers to. Never write a real address into the
# source or into this file — .env.example is committed, and a public repository
# is the last place an inbox wants to be. Put the real one in .env only.
CONTACT_TO=you@example.com

# The account that sends. It has nothing to do with the receiving address: any
# SMTP server can deliver to any mailbox. Note if you are pointing CONTACT_TO
# at Proton — receiving there is fine, but sending *through* Proton needs a
# Business plan with an SMTP submission token.
CONTACT_FROM=noreply@your-domain.example
SMTP_HOST=
# 587 with STARTTLS is the one to reach for. Yahoo, tested, answers 465 with
# "550 Request failed; Mailbox unavailable" after accepting the login — which
# reads like a rejected address and is really the wrong port.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Leave blank to infer from the port: implicit TLS on 465, STARTTLS otherwise.
SMTP_SECURE=
# "true" logs the whole SMTP conversation while diagnosing a refusal. It
# includes the AUTH exchange, so switch it back off afterwards.
SMTP_DEBUG=

# Where messages are kept. They are written down before any mail is attempted,
# so nothing is lost when SMTP is unset, wrong, or temporarily refusing.
CONTACT_STORE_PATH=data/contact-messages.json

# ─── The town vault ──────────────────────────────────────────────────────────
# Sealed rooms residents keep for invited guests. Stored here, unreadable here:
# the contents are encrypted in the resident's browser before they arrive and
# the key is wrapped to each guest separately. That also means a lost vault
# cannot be reconstructed by anyone, including you — back it up.
VAULT_STORE_PATH=data/vault.json
